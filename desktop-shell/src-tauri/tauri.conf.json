{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeChat Auto Shell",
  "version": "0.1.0",
  "identifier": "com.wechatauto.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WeChat Auto Shell",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/wechat-auto-backend",
      "binaries/group_listener_worker"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
